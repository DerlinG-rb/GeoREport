<resources>
    <style name="Widget.GeoReport.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Widget.GeoReport.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">true</item>
        <item name="expandedHintEnabled">false</item>
        <item name="boxBackgroundColor">@color/surface_card</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="passwordToggleTint">@color/text_secondary</item>
    </style>
    <style name="Widget.GeoReport.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="hintEnabled">true</item>
        <item name="expandedHintEnabled">false</item>
        <item name="boxBackgroundColor">@color/surface_card</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>
    <style name="Widget.GeoReport.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Widget.GeoReport.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
